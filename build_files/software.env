# This file declares the additional Fedora software included in Home Server Gina.
#
# Most software is shared by both Gina images. HCI-only software is installed
# separately when the uCore HCI base is selected.
#
# Fedora packages are updated through the normal Fedora/uCore package sources
# whenever the image is rebuilt. Third-party source-built packages such as
# UPSide, Superfile and VirtUI Manager are maintained by Home Server Packages.


# ------------------------------------------------------------
# Native Fedora packages added by Gina
# ------------------------------------------------------------

GINA_EXTRA_PACKAGES="nut nut-client powertop btop fastfetch micro"


# ------------------------------------------------------------
# NetBird
# ------------------------------------------------------------
#
# NetBird requires special installation handling during image composition,
# so it is kept separate from the normal package list.

NETBIRD_PACKAGE="netbird"
