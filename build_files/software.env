# This file declares the additional Fedora software included in Home Server Gina.
#
# Most software is shared by both Gina images. HCI-only software is installed
# separately when the uCore HCI base is selected.
#
# Fedora packages are updated through the normal Fedora/uCore package sources
# whenever the image is rebuilt. Third-party packaged applications such as
# UPSide and VirtUI Manager are maintained by Home Server Packages.


# ------------------------------------------------------------
# Native Fedora packages added by Gina
# ------------------------------------------------------------

GINA_EXTRA_PACKAGES="nut nut-client powertop file git zstd gcc gcc-c++ make procps-ng"


# ------------------------------------------------------------
# NetBird
# ------------------------------------------------------------
#
# NetBird is installed without RPM scriptlets during bootc composition,
# then its service is installed explicitly with the upstream NetBird CLI.

NETBIRD_PACKAGE="netbird"
